  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="1887年波兰医生柴门霍夫（1859.12.15-1917.4.14）创造了世界语，旨在消除国际语言障碍，促进人类和平与友谊。一百多年來，世界语得到包括中国在内的许多国家政府以及联合国教科文组织的文持。2004年7月，第89届国际世界语大会在北京召开之际，各国世界语者在此建立世界语林，以为纪念。"/>
  <tag k="material" v="stone"/>
  <tag k="memorial" v="stele"/>
  <tag k="name" v="世界语林"/>
  <tag k="name:eo" v="Esperanto-Bosko"/>
  <tag k="start_date" v="2004.7"/>
 </node>
